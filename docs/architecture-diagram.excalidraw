      "isDeleted": false,
      "boundElements": [],
      "updated": 1741500000000,
      "link": null,
      "locked": false,
      "text": "\u2022 Structured JSON Logs: Request lifecycle, Upstream attempts/latency/cache, Decision selected counts, Generation tokens.\n\u2022 Strict Data Privacy: Full user questions, prompts, birth details, and API credentials are NEVER written to logs or exposed.",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
